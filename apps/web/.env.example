# 서버 환경 예시. DB·이메일 인증 API/화면·Resend 전송을 연결했습니다. 소셜 인증은 후속입니다.
# 실제 값은 apps/web/.env.local에 저장하고 커밋하지 않습니다.
# 앱 전용 moa_runtime의 Supabase Session pooler 접속값. 공개 CA와 TLS 검증을 사용합니다.
DATABASE_URL=
# DDL 전용 역할의 URL(schema=moa_app). CLI에 명시적으로 제공하며 runtime과 분리합니다.
MIGRATION_DATABASE_URL=

# 로컬 실행 주소. Vercel Production에는 운영 사이트 주소를 별도로 설정합니다.
BETTER_AUTH_URL=http://127.0.0.1:3034
# 안전한 난수로 생성한 서버 인증 비밀값. 예제에는 실제 값을 넣지 않습니다.
BETTER_AUTH_SECRET=

# 소셜 로그인: 카카오 CLIENT_ID는 REST API 키입니다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# 메일 발송 준비. 테스트 발신자는 Resend 가입 이메일로만 발송할 수 있습니다.
RESEND_API_KEY=
EMAIL_FROM="Moa <onboarding@resend.dev>"

AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# 샘플·정식 AI 공급자. 미지정이면 OpenAI 키 우선, 없으면 Gemini를 선택합니다.
# openai 또는 gemini. 선택한 공급자의 키가 없거나 호출에 실패해도 자동 대체하지 않습니다.
AI_PROVIDER=
# OpenAI Responses: gpt-6-luna. 서버에서만 읽습니다.
OPENAI_API_KEY=
# 공개 배포의 샘플 AI 전송은 기본 비활성입니다. 비용 사용을 명시적으로 허용할 때만 true로 설정합니다.
# 로컬 http://127.0.0.1 또는 localhost 실행은 기본 허용이며 false로 끌 수 있습니다.
ENABLE_PUBLIC_SAMPLE_AI=
# Gemini: gemini-3.5-flash-lite. 서버에서만 읽습니다.
GEMINI_API_KEY=

